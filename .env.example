# Postgres connection string for the shared multi-tenant database.
# Every tenant-scoped table lives in this one database, isolated by
# Row-Level Security keyed on tenant_id — see docs/architecture-plan.md §2.
DATABASE_URL=postgresql://user:password@host:5432/stcommand

# Master key used to encrypt tenant secrets at rest (SpaceTraders tokens,
# LLM API keys, Discord webhooks) and to HMAC-sign session cookies.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Local dev only. Production always runs against DATABASE_URL above.
PORT=3000

# Shared secret for the operator-only /admin page (list/delete tenants —
# see src/http/admin.ts). Unset = /admin disabled entirely (every
# /api/admin/* request 503s), not "no password" — this must fail closed.
# Generate with: openssl rand -hex 32
ADMIN_KEY=

# Optional, per tenant: route a tenant's SpaceTraders API calls through its
# own forward proxy instead of this process's own IP. SpaceTraders rate-
# limits by source IP, not by agent token — every tenant without one of
# these shares this process's one IP (and its one 2 req/s ceiling) via
# TenantRegistry's shared RateLimiter; a tenant with one gets its own real
# ceiling instead. Key is PROXY_URL_<AGENTSYMBOL> in uppercase, value is a
# full proxy URL including credentials: http://user:pass@host:port.
# PROXY_URL_DRAGOM=
# PROXY_URL_CARO=
# PROXY_URL_EWOK=

# Optional: send the galaxy crawler's public (tokenless) reads through a proxy, so they leave from a second IP with their own
# limiter instead of drawing from this box's budget. Same format as above: http://user:pass@host:port/ (an HTTP CONNECT proxy).
# CRAWLER_PROXY_RATE is the crawler's own requests a second (default 1, 0.2-1.9). Unset = the crawler uses the box's IP as before.
# CRAWLER_PROXY_URL=
# CRAWLER_PROXY_RATE=1

# Optional: a second IP for the calls nothing waits on (src/engine/apiLanes.ts). With this set, read-only GETs at deferrable or
# background priority (keeper market and shipyard reads, remote surveys, fleet-state refreshes) can leave through the proxy with
# their own token bucket, while trades, jumps and every write stay on this box's IP. Nothing uses it until the doctrine clause
# apiLaneProxy is switched on, and it ships off. Same URL format as above. API_LANE_PROXY_RATE is the proxy IP's own requests a second
# (default: API_RATE; the game allows 2 a second per IP). If the proxy fails, reads fall back to this box's IP.
# API_LANE_PROXY_URL=
# API_LANE_PROXY_RATE=

# Optional: push notifications in Tower (docs/notifications.md). Both keys must be set or push is off, and Tower's
# Alerts tab says so. Generate a pair once with `npm run vapid`, keep the private key secret, and never change the
# pair afterwards: devices subscribed under the old public key stop receiving anything and must turn alerts on again.
# VAPID_SUBJECT is a contact the push services can reach, mailto: or https:.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Watches the public agent list and start-system gates every 15 minutes (docs/agent-watch.md). off disables it.
# AGENT_WATCH=on

# Tokens the shared SpaceTraders limiter holds (default 5, range 1-30). The game allows 2 req/s with a burst of 30, but 30 at once drew 429s;
# raise it only after scripts/rate-limit-probe.mjs --burst=N shows the IP tolerates that spike.
# API_BURST=5
