# Postgres connection string for the shared multi-tenant database.
# Every tenant-scoped table lives in this one database, isolated by
# Row-Level Security keyed on tenant_id — see docs/architecture-plan.md §2.
DATABASE_URL=postgresql://user:password@host:5432/stcommand

# Master key used to encrypt tenant secrets at rest (SpaceTraders tokens,
# LLM API keys, Discord webhooks) and to HMAC-sign session cookies.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Local dev only. Production always runs against DATABASE_URL above.
PORT=3000

# Shared secret for the operator-only /admin page (list/delete tenants —
# see src/http/admin.ts). Unset = /admin disabled entirely (every
# /api/admin/* request 503s), not "no password" — this must fail closed.
# Generate with: openssl rand -hex 32
ADMIN_KEY=
