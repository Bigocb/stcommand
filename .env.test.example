# Copy to .env.test and fill in. Loaded automatically by `npm test`
# (node --env-file-if-exists=.env.test), so the suite works with no manual
# exports. Gitignored — never commit real credentials.

# Any Postgres the suite may freely destroy data in. Can be the same
# instance as DATABASE_URL: DB_SCHEMA below is what keeps them apart.
TEST_DATABASE_URL=postgresql://user:password@host:5432/database

# MUST NOT be the production schema. store.test.ts and
# tenantRegistry.test.ts both DELETE FROM tenants; pointed at `stcommand`
# that would destroy the running fleet's data. `npm run pretest` refuses to
# start if this is unset or set to stcommand.
DB_SCHEMA=stcommand_test
