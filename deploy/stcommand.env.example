# stcommand environment — key inventory only, never values.
# The live file is /home/bigocb/media-stack/configs/stcommand/stcommand.env (mode 600).

# Postgres DSN. localhost/127.0.0.1 disables TLS in src/db/pool.ts.
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/DBNAME
PORT=3002
NODE_ENV=production

# Heap headroom (stopgap after the 2026-11-27 4 GB V8 OOM).
NODE_OPTIONS=--max-old-space-size=8192

# Secrets — set on the box only.
SESSION_SECRET=
ADMIN_KEY=
ST_ACCOUNT_TOKEN=

# Engine behaviour.
OPERATOR_AGENTS=
AUTO_RESET_RECOVERY=
API_BURST=
API_LANE_PROXY_URLS=
API_LANE_PROXY_RATE=
CRAWLER_PROXY_URL=
CRAWLER_PROXY_RATE=
TRADE_LANE_AVOID=

# Web push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
